APP_ENV=local

# ===== 主对话模型 (DeepSeek) =====
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-your-api-key-here
MODEL_NAME=deepseek-chat

# ===== LLM 裁判模型 (文本评分, 默认同主模型) =====
JUDGE_MODEL_PROVIDER=deepseek
JUDGE_MODEL_BASE_URL=https://api.deepseek.com/v1
JUDGE_MODEL_API_KEY=sk-your-api-key-here
JUDGE_MODEL_NAME=deepseek-chat

# ===== 场景匹配模型 (独立配置, 默认同主模型) =====
SCENARIO_MATCH_MODEL_BASE_URL=https://api.deepseek.com/v1
SCENARIO_MATCH_MODEL_API_KEY=sk-your-api-key-here
SCENARIO_MATCH_MODEL_NAME=deepseek-chat
SCENARIO_MATCH_CONFIDENCE_THRESHOLD=0.70

# ===== 兼容字段 =====
# 如果 MODEL_API_KEY 未配置, 系统会读取 DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-your-api-key-here

# ===== 运行时配置 =====
RUNS_DIR=./database
ARCHIVE_DB_PATH=./database/eval_archive.sqlite3
ENABLE_LLM_JUDGE=true
SCENARIO_COUNT=15
MAX_TURNS=20
