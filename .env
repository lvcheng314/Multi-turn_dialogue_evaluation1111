APP_ENV=local

# 页面和后端服务在本地运行；LLM 通过云端 API 调用，不在本地部署模型。
# 将本文件复制为 .env 后，把下面的占位符替换为你的云端模型配置。
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-099e63642ad640eba9096d2ad79ae564
MODEL_NAME=deepseek-chat

# 打分器建议单独使用同一个云端模型，也可以配置为更强的 judge 模型。
JUDGE_MODEL_PROVIDER=deepseek
JUDGE_MODEL_BASE_URL=https://api.deepseek.com/v1
JUDGE_MODEL_API_KEY=sk-5703b442cd0044d3b263b46973166807
JUDGE_MODEL_NAME=deepseek-chat

# 兼容字段：如果 MODEL_API_KEY 没有配置，系统会尝试读取 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=sk-099e63642ad640eba9096d2ad79ae564

RUNS_DIR=./runs
ARCHIVE_DB_PATH=./runs/eval_archive.sqlite3

# 是否启用云端 LLM 文本评分。false 时只跑规则评分和工具轨迹评分，演示更稳定。
ENABLE_LLM_JUDGE=false
SCENARIO_COUNT=15
MAX_TURNS=20
